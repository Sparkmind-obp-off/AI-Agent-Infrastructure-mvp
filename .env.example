# Server-side identity configuration. Values are deployment-specific; never commit real values.
APP_ENV=development
AUTH0_ISSUER=
AUTH0_AUDIENCE=

# Explicit local/test-only identity. Both the non-production APP_ENV and gate are required.
AUTH_TEST_MODE=false
AUTH_TEST_SIGNING_SECRET=

# Browser-safe Auth0 application configuration, injected at build time.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_ENABLE_TEST_AUTH=false

# Execution configuration.
E2B_API_KEY=
EXECUTION_PROVIDER=mock
